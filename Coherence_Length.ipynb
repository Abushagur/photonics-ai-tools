   "source": [
    "import numpy as np\n",
    "def coherence_lengh(delta_lambda_nm, lambda_nm):\n",
    "    \"\"\"Compute coherence  length\"\"\"\n",
    "\n",
    "lambda_nm=1550   #  central wavelength\n",
    "delta_lambda_nm=0.01  # linewidth in nm\n",
    "cl=(2*np.log(2)/np.pi)*(lambda_nm**2/delta_lambda_nm)\n",
    "\n",
    "print(f\"cl: {cl:.4e} nm\")"
   ]
